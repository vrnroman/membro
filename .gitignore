# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# local CLI tokens (temporary, used during setup, safe to delete)
.supabase-token
.vercel-token

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase DB password (keep safe, git-ignored)
.supabase-db-password
.env*

# Local-first SQLite data (the app's database lives here on the VM)
/data
*.db
*.db-shm
*.db-wal

# Private planning / status doc — kept local, never published
/ROADMAP.md
# Private feature roadmap folder (the people-layer briefs) — kept local, never published
/roadmap/
