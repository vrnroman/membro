# Membro configuration. Copy to .env (gitignored) and fill in what you need.
# Membro is local-first: it stores everything in one SQLite file and runs the AI
# on your own Claude subscription, so most of these are optional.

# Where the SQLite database file lives. Defaults to ./data for local dev; point
# it at a persistent disk when self-hosting.
MEMBRO_DATA_DIR=./data

# The owner's email — the ONE account allowed to use this app. Membro is single-user
# and its database has no per-user separation, so whoever gets in sees everything.
# When set, the app serves only requests whose auth-proxy identity header
# (X-Auth-Request-Email) matches this address, and refuses everyone else with a 403.
# REQUIRED when self-hosting: in production the app fails closed without it. Leave
# it unset for local dev, where there is no proxy and nothing is exposed.
# This is deliberately a second lock — your auth proxy is the first. Do not rely on
# the proxy alone; a single misread setting there once left this app open to every
# Google account on earth (see deploy/harden-oauth2-proxy.sh).
# MEMBRO_OWNER_EMAIL=you@example.com

# Which AI engine to use: cli (claude -p, the default), api (Anthropic API), or
# mock (deterministic offline, used by the tests).
MEMBRO_AI=cli

# For the claude -p engine: path to the CLI and the model it should call.
# MEMBRO_CLAUDE_BIN=/usr/bin/claude
# MEMBRO_CLAUDE_MODEL=claude-opus-4-8

# Optional: set a key to switch to the Anthropic API engine instead of the CLI.
# ANTHROPIC_API_KEY=
# MEMBRO_MODEL=claude-opus-4-8

# Voice notes: Gemini transcribes the audio (Claude still does everything else).
# GEMINI_API_KEY=
# MEMBRO_GEMINI_MODEL=gemini-2.5-flash

# Comma-separated product or client words to spell correctly in transcription.
# Keep private terms here, out of the codebase.
# MEMBRO_HOUSE_TERMS=

# Morning nudge over Telegram: when something is due today or tomorrow, the VM
# sends the bulleted list to this bot chat (one bullet per line). Create a bot
# with @BotFather for the token; the chat id is your own numeric id (message the
# bot once, then read it from https://api.telegram.org/bot<token>/getUpdates).
# Keep both in the VM .env only.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# The owner's timezone (IANA name). This is the single notion of "today" across
# the app (the Today screen, capture's relative dates, and the nudge). Defaults
# to Asia/Singapore; a missing or invalid value falls back to that default.
# MEMBRO_TZ=Asia/Singapore
# By default a quiet day still sends a short "Nothing due today or tomorrow." so
# you can see the service is alive. Set to 1 to stay silent on empty days instead.
# MEMBRO_NUDGE_SILENT_WHEN_EMPTY=1

# Optional tracing.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
